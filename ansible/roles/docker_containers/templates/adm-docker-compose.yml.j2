version: '3.8'

services:
  adm:
    build:
      context: ./app
      dockerfile: Dockerfile
    container_name: adm-{{ primary_domain | replace('.', '-') }}
    restart: unless-stopped
    environment:
      - DOMAIN=${DOMAIN:-{{ primary_domain }}}
      - DATABASE_HOST=host.docker.internal
      - DATABASE_NAME=hibana
      - DATABASE_USER=hibana
      - DATABASE_PASSWORD_FILE=/run/secrets/db_password
      - PDNS_PASSWORD_FILE=/run/secrets/pdns_password
      - JWT_SECRET_FILE=/run/secrets/jwt_secret
      - API_PORT=${API_PORT:-3000}
    volumes:
      - ./logs:/var/log/adm
      - ./data:/app/data
      - /var/run/docker.sock:/var/run/docker.sock
      - /srv:/srv
    networks:
      - traefik-network
    extra_hosts:
      - "host.docker.internal:host-gateway"
    secrets:
      - db_password
      - pdns_password
      - jwt_secret
    labels:
      - "traefik.enable=true"
      # HTTP router for ACME challenges and redirect
      - "traefik.http.routers.adm-{{ primary_domain | replace('.', '-') }}-http.rule=Host(`adm.{{ primary_domain }}`)"
      - "traefik.http.routers.adm-{{ primary_domain | replace('.', '-') }}-http.entrypoints=web"
      # HTTPS router
      - "traefik.http.routers.adm-{{ primary_domain | replace('.', '-') }}.rule=Host(`adm.{{ primary_domain }}`)"
      - "traefik.http.routers.adm-{{ primary_domain | replace('.', '-') }}.entrypoints=websecure"
      - "traefik.http.routers.adm-{{ primary_domain | replace('.', '-') }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.adm-{{ primary_domain | replace('.', '-') }}.middlewares=security-headers@file,rate-limit@file"
      # Service configuration
      - "traefik.http.services.adm-{{ primary_domain | replace('.', '-') }}.loadbalancer.server.port=3000"

networks:
  traefik-network:
    external: true

secrets:
  db_password:
    file: ./secrets/db_password
  pdns_password:
    file: ./secrets/pdns_password
  jwt_secret:
    file: ./secrets/jwt_secret
