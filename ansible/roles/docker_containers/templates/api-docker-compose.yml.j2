version: '3.8'

services:
  api:
    build:
      context: ./app
      dockerfile: Dockerfile
    container_name: api-{{ primary_domain | replace('.', '-') }}
    restart: unless-stopped
    environment:
      - DOMAIN=${DOMAIN:-{{ primary_domain }}}
      - DATABASE_HOST=host.docker.internal
      - DATABASE_NAME=hibana
      - DATABASE_USER=hibana
      - DATABASE_PASSWORD_FILE=/run/secrets/db_password
      - PDNS_PASSWORD_FILE=/run/secrets/pdns_password
      - JWT_SECRET_FILE=/run/secrets/jwt_secret
      - API_PORT=${API_PORT:-3000}
    volumes:
      - ./logs:/var/log/api
      - ./data:/app/data
    networks:
      - traefik-network
    extra_hosts:
      - "host.docker.internal:host-gateway"
    secrets:
      - db_password
      - pdns_password
      - jwt_secret
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.api.rule=Host(`adm.{{ primary_domain }}`)"
      - "traefik.http.routers.api.entrypoints=websecure"
      - "traefik.http.routers.api.tls.certresolver=letsencrypt"
      - "traefik.http.services.api.loadbalancer.server.port=3000"
      - "traefik.http.routers.api.middlewares=security-headers@file,rate-limit@file"

networks:
  traefik-network:
    external: true

secrets:
  db_password:
    file: ./secrets/db_password
  pdns_password:
    file: ./secrets/pdns_password
  jwt_secret:
    file: ./secrets/jwt_secret
