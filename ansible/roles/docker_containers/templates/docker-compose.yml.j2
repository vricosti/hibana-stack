version: '3.8'

services:
  traefik:
    image: traefik:v2.10
    container_name: hibana-traefik
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - /etc/hibana/traefik/traefik.toml:/etc/traefik/traefik.toml:ro
      - /etc/hibana/traefik/config:/etc/traefik/config:ro
      - /etc/hibana/traefik/acme.json:/etc/traefik/acme.json
    networks:
      - hibana-network
    labels:
      - "traefik.enable=true"

  www:
    build: ./www
    container_name: hibana-www
    restart: unless-stopped
    networks:
      - hibana-network
    labels:
      - "traefik.enable=true"
      # HTTP router (exclude ACME challenges to let Traefik handle them)
      - "traefik.http.routers.www-http.rule=(Host(`www.{{ primary_domain }}`) || Host(`{{ primary_domain }}`)) && !PathPrefix(`/.well-known/acme-challenge/`)"
      - "traefik.http.routers.www-http.entrypoints=web"
      - "traefik.http.routers.www-http.priority=1"
      # HTTPS router
      - "traefik.http.routers.www.rule=Host(`www.{{ primary_domain }}`) || Host(`{{ primary_domain }}`)"
      - "traefik.http.routers.www.entrypoints=websecure"
      - "traefik.http.routers.www.tls.certresolver=letsencrypt"
      - "traefik.http.routers.www.middlewares=security-headers@file,compress@file"
      # Service configuration
      - "traefik.http.services.www.loadbalancer.server.port=80"

  adm:
    build: ./adm
    container_name: hibana-adm
    restart: unless-stopped
    networks:
      - hibana-network
    environment:
      - DOMAIN={{ primary_domain }}
    labels:
      - "traefik.enable=true"
      # HTTP router (exclude ACME challenges to let Traefik handle them)
      - "traefik.http.routers.adm-http.rule=Host(`adm.{{ primary_domain }}`) && !PathPrefix(`/.well-known/acme-challenge/`)"
      - "traefik.http.routers.adm-http.entrypoints=web"
      - "traefik.http.routers.adm-http.priority=1"
      # HTTPS router
      - "traefik.http.routers.adm.rule=Host(`adm.{{ primary_domain }}`)"
      - "traefik.http.routers.adm.entrypoints=websecure"
      - "traefik.http.routers.adm.tls.certresolver=letsencrypt"
      - "traefik.http.routers.adm.middlewares=security-headers@file,rate-limit@file"
      # Service configuration
      - "traefik.http.services.adm.loadbalancer.server.port=80"

  webmail:
    image: roundcube/roundcubemail:latest
    container_name: hibana-webmail
    restart: unless-stopped
    networks:
      - hibana-network
    extra_hosts:
      - "mail.{{ primary_domain }}:host-gateway"
    environment:
      - ROUNDCUBEMAIL_DEFAULT_HOST=mail.{{ primary_domain }}
      - ROUNDCUBEMAIL_SMTP_SERVER=mail.{{ primary_domain }}
      - ROUNDCUBEMAIL_DEFAULT_PORT=143
      - ROUNDCUBEMAIL_SMTP_PORT=587
      - ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE=30M
    labels:
      - "traefik.enable=true"
      # HTTP router (exclude ACME challenges to let Traefik handle them)
      - "traefik.http.routers.webmail-http.rule=Host(`webmail.{{ primary_domain }}`) && !PathPrefix(`/.well-known/acme-challenge/`)"
      - "traefik.http.routers.webmail-http.entrypoints=web"
      - "traefik.http.routers.webmail-http.priority=1"
      # HTTPS router
      - "traefik.http.routers.webmail.rule=Host(`webmail.{{ primary_domain }}`)"
      - "traefik.http.routers.webmail.entrypoints=websecure"
      - "traefik.http.routers.webmail.tls.certresolver=letsencrypt"
      - "traefik.http.routers.webmail.middlewares=security-headers@file"
      # Service configuration
      - "traefik.http.services.webmail.loadbalancer.server.port=80"

networks:
  hibana-network:
    external: true
