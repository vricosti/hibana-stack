# Traefik Dynamic Configuration - Domain Redirects
# Generated by Hibana Stack

http:
{% if domain_redirects is defined and domain_redirects | length > 0 %}
  routers:
{% for redirect in domain_redirects %}
    redirect-{{ redirect.from | replace('.', '-') }}:
      rule: "Host(`{{ redirect.from }}`) || Host(`www.{{ redirect.from }}`)"
      entryPoints:
        - websecure
      middlewares:
        - redirect-{{ redirect.from | replace('.', '-') }}
      service: noop-{{ redirect.from | replace('.', '-') }}
      tls:
        certResolver: letsencrypt
{% endfor %}

  middlewares:
{% for redirect in domain_redirects %}
    redirect-{{ redirect.from | replace('.', '-') }}:
      redirectRegex:
        regex: "^https?://(?:www\\.)?{{ redirect.from | replace('.', '\\.') }}(.*)"
{% if redirect.to is defined and redirect.to %}
        replacement: "{{ redirect.to }}${1}"
{% else %}
        replacement: "https://{{ primary_domain }}${1}"
{% endif %}
{% if redirect.permanent | default(false) %}
        permanent: true
{% else %}
        permanent: false
{% endif %}
{% endfor %}

  services:
{% for redirect in domain_redirects %}
    noop-{{ redirect.from | replace('.', '-') }}:
      loadBalancer:
        servers:
          - url: "http://localhost"
{% endfor %}
{% else %}
  routers: {}
  middlewares: {}
  services: {}
{% endif %}
