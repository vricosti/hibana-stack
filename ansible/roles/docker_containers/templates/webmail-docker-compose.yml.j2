version: '3.8'

services:
  webmail:
    image: roundcube/roundcubemail:latest
    container_name: webmail-{{ primary_domain | replace('.', '-') }}
    restart: unless-stopped
    environment:
      - ROUNDCUBEMAIL_DEFAULT_HOST=ssl://{{ mailserver_subdomain }}.{{ primary_domain }}
      - ROUNDCUBEMAIL_SMTP_SERVER=tls://{{ mailserver_subdomain }}.{{ primary_domain }}
      - ROUNDCUBEMAIL_DEFAULT_PORT=993
      - ROUNDCUBEMAIL_SMTP_PORT=587
      - ROUNDCUBEMAIL_IMAP_SSL_VERIFY_HOST=false
      - ROUNDCUBEMAIL_IMAP_SSL_VERIFY_PEER=false
      - ROUNDCUBEMAIL_SMTP_SSL_VERIFY_HOST=false
      - ROUNDCUBEMAIL_SMTP_SSL_VERIFY_PEER=false
      - ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE=${UPLOAD_MAX_SIZE:-30M}
      - ROUNDCUBEMAIL_DB_TYPE=${DB_TYPE:-sqlite}
      - ROUNDCUBEMAIL_USERNAME_DOMAIN=${USERNAME_DOMAIN:-{{ primary_domain }}}
    volumes:
      - ./data:/var/roundcube/db
      - ./logs:/var/log/apache2
      - ./custom.inc.php:/var/roundcube/config/config.inc.php:ro
    networks:
      - traefik-network
    extra_hosts:
      - "{{ mailserver_subdomain }}.{{ primary_domain }}:host-gateway"
    labels:
      - "traefik.enable=true"
      # HTTP router (exclude ACME challenges to let Traefik handle them)
      - "traefik.http.routers.webmail-{{ primary_domain | replace('.', '-') }}-http.rule=Host(`webmail.{{ primary_domain }}`) && !PathPrefix(`/.well-known/acme-challenge/`)"
      - "traefik.http.routers.webmail-{{ primary_domain | replace('.', '-') }}-http.entrypoints=web"
      - "traefik.http.routers.webmail-{{ primary_domain | replace('.', '-') }}-http.priority=1"
      # HTTPS router
      - "traefik.http.routers.webmail-{{ primary_domain | replace('.', '-') }}.rule=Host(`webmail.{{ primary_domain }}`)"
      - "traefik.http.routers.webmail-{{ primary_domain | replace('.', '-') }}.entrypoints=websecure"
      - "traefik.http.routers.webmail-{{ primary_domain | replace('.', '-') }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.webmail-{{ primary_domain | replace('.', '-') }}.middlewares=security-headers@file"
      # Service configuration
      - "traefik.http.services.webmail-{{ primary_domain | replace('.', '-') }}.loadbalancer.server.port=80"

networks:
  traefik-network:
    external: true
