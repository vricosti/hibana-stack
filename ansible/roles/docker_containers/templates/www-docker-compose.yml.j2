version: '3.8'

services:
  web:
    build:
      context: ./src
      dockerfile: Dockerfile
    container_name: www-{{ primary_domain | replace('.', '-') }}
    restart: unless-stopped
    volumes:
      - ./logs:/var/log/nginx
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    networks:
      - traefik-network
    labels:
      - "traefik.enable=true"
      # HTTP router (exclude ACME challenges to let Traefik handle them)
      - "traefik.http.routers.www-{{ primary_domain | replace('.', '-') }}-http.rule=(Host(`www.{{ primary_domain }}`) || Host(`{{ primary_domain }}`)) && !PathPrefix(`/.well-known/acme-challenge/`)"
      - "traefik.http.routers.www-{{ primary_domain | replace('.', '-') }}-http.entrypoints=web"
      - "traefik.http.routers.www-{{ primary_domain | replace('.', '-') }}-http.priority=1"
      # HTTPS router
      - "traefik.http.routers.www-{{ primary_domain | replace('.', '-') }}.rule=Host(`www.{{ primary_domain }}`) || Host(`{{ primary_domain }}`)"
      - "traefik.http.routers.www-{{ primary_domain | replace('.', '-') }}.entrypoints=websecure"
      - "traefik.http.routers.www-{{ primary_domain | replace('.', '-') }}.tls.certresolver=letsencrypt"
      - "traefik.http.routers.www-{{ primary_domain | replace('.', '-') }}.middlewares=security-headers@file,compress@file"
      # Service configuration
      - "traefik.http.services.www-{{ primary_domain | replace('.', '-') }}.loadbalancer.server.port=80"

networks:
  traefik-network:
    external: true
