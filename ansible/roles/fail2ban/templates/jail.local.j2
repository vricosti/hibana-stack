# Fail2Ban Configuration for Hibana Stack
# Generated by Hibana Stack Ansible

[DEFAULT]
# Ban settings
bantime  = 1h
findtime = 10m
maxretry = 5

# Action: ban using UFW
banaction = ufw
action = %(action_mwl)s

# Email notifications (optional - configure if needed)
# destemail = admin@{{ primary_domain }}
# sender = fail2ban@{{ primary_domain }}

# Ignore local IPs
ignoreip = 127.0.0.1/8 ::1

# Enable logging
logtarget = /var/log/fail2ban.log

#
# SSH Protection
#
[sshd]
enabled = true
port = ssh
logpath = %(sshd_log)s
backend = %(sshd_backend)s
maxretry = 5
bantime = 1h

#
# Dovecot IMAP/POP3 Protection
#
[dovecot]
enabled = true
port = imap,imaps,pop3,pop3s
filter = dovecot
logpath = /var/log/mail.log
maxretry = 5
bantime = 1h

#
# Postfix SMTP Protection
#
[postfix]
enabled = true
port = smtp,submission,smtps
filter = postfix
logpath = /var/log/mail.log
maxretry = 5
bantime = 1h

#
# Postfix SASL Authentication Protection
#
[postfix-sasl]
enabled = true
port = smtp,submission,smtps
filter = postfix-sasl
logpath = /var/log/mail.log
maxretry = 5
bantime = 1h

#
# Roundcube Webmail Protection
# Note: Roundcube auth failures are caught by Dovecot jail
# This jail catches specific Roundcube application errors
#
[roundcube]
enabled = false
port = http,https
filter = roundcube
logpath = /var/log/syslog
maxretry = 5
bantime = 30m
findtime = 5m

#
# Apache Bad Bots (disabled - Roundcube runs in Docker)
#
[apache-badbots]
enabled = false
port = http,https
logpath = /var/log/apache2/*error.log
maxretry = 2
bantime = 2h
