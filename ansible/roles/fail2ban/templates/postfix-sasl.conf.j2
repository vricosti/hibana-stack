# Fail2Ban filter for Postfix SASL authentication failures
# Detects brute-force attempts on SMTP authentication

[Definition]

# Match SASL authentication failures
failregex = ^%(__prefix_line)s(?:warning: )?[-._\w]+\[<HOST>\]: SASL (?:LOGIN|PLAIN|(?:CRAM|DIGEST)-MD5) authentication failed(?:: [ A-Za-z0-9+/]*={0,2})?\s*$
            ^%(__prefix_line)swarning: [-._\w]+\[<HOST>\]: SASL authentication failed.*$
            ^%(__prefix_line)slost connection after AUTH from [-._\w]+\[<HOST>\].*$

ignoreregex =

