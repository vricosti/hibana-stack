# HAProxy Mail Proxy Configuration
# Generated by Hibana Stack
# Routes mail traffic to per-domain mail containers using SNI

global
    log stdout format raw local0
    maxconn 4096
    tune.ssl.default-dh-param 2048

defaults
    log global
    mode tcp
    option tcplog
    option dontlognull
    timeout connect 10s
    timeout client 300s
    timeout server 300s
    retries 3

# =============================================================================
# SMTP (Port 25) - Incoming mail
# Cannot use SNI (no TLS at start), routes to primary mail container
# =============================================================================
frontend ft_smtp
    bind *:25
    mode tcp
    default_backend bk_smtp_default

backend bk_smtp_default
    mode tcp
    server mail-primary hibana-mail-{{ primary_domain | replace('.', '-') }}:25 check

# =============================================================================
# SMTPS (Port 465) - TLS from start, can use SNI
# =============================================================================
frontend ft_smtps
    bind *:465
    mode tcp
    tcp-request inspect-delay 5s
    tcp-request content accept if { req_ssl_hello_type 1 }

{% for domain in domains %}
    # Route for {{ domain.name }}
    use_backend bk_smtps_{{ domain.name | replace('.', '-') }} if { req_ssl_sni -i {{ mailserver_subdomain }}.{{ domain.name }} }
{% endfor %}

    default_backend bk_smtps_default

{% for domain in domains %}
backend bk_smtps_{{ domain.name | replace('.', '-') }}
    mode tcp
    server mail-{{ domain.name | replace('.', '-') }} hibana-mail-{{ domain.name | replace('.', '-') }}:465 check

{% endfor %}
backend bk_smtps_default
    mode tcp
    server mail-primary hibana-mail-{{ primary_domain | replace('.', '-') }}:465 check

# =============================================================================
# Submission (Port 587) - STARTTLS
# Routes based on SNI after STARTTLS negotiation
# =============================================================================
