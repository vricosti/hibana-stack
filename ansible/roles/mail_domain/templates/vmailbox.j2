# Postfix virtual mailbox map - Generated by Hibana Stack
# Maps email addresses to maildir paths
{% set existing_entries = existing_vmailbox.stdout_lines | default([]) | select('match', '^[^#]') | list %}
{% set existing_emails = existing_entries | map('split') | map('first') | list %}
{% for line in existing_entries %}
{{ line }}
{% endfor %}
{% for domain in domains %}
{% if domain.subdomains | selectattr('role', 'equalto', 'mailserver') | list | length > 0 %}
{% for account in domain.email_accounts | default([]) %}
{% set email = account.username ~ '@' ~ domain.name %}
{% if email not in existing_emails %}
{{ email }} {{ domain.name }}/{{ account.username }}/
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
