# Dovecot SQL Configuration
# Generated by Hibana Stack

# Database connection
driver = pgsql
connect = host=localhost dbname=hibana user=hibana password={{ lookup('file', '/etc/hibana/passwords/hibana') }}

# Password query - joins email_accounts with domains to get full email address
password_query = SELECT \
  e.username || '@' || d.name AS user, \
  e.password_hash AS password \
  FROM email_accounts e \
  JOIN domains d ON e.domain_id = d.id \
  WHERE e.username = '%n' AND d.name = '%d'

# User query
user_query = SELECT \
  '/var/mail/vhosts/%d/%n' AS home, \
  'vmail' AS uid, \
  'vmail' AS gid \
  FROM email_accounts e \
  JOIN domains d ON e.domain_id = d.id \
  WHERE e.username = '%n' AND d.name = '%d'

# Default password scheme - bcrypt
default_pass_scheme = BLF-CRYPT
