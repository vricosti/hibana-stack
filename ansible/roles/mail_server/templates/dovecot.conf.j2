# Dovecot Configuration
# Generated by Hibana Stack

protocols = imap pop3 lmtp
listen = *, ::

# SSL/TLS
ssl = yes
ssl_cert = </etc/ssl/certs/hibana-{{ primary_domain }}.crt
ssl_key = </etc/ssl/private/hibana-{{ primary_domain }}.key
ssl_min_protocol = TLSv1.2

# Allow plaintext authentication (needed for Roundcube connecting over internal network)
disable_plaintext_auth = no

# Mail location
mail_location = maildir:/var/mail/vhosts/%d/%n
mail_privileged_group = vmail

# Authentication
auth_mechanisms = plain login

# SQL Authentication
passdb {
  driver = sql
  args = /etc/dovecot/dovecot-sql.conf.ext
}

userdb {
  driver = static
  args = uid=vmail gid=vmail home=/var/mail/vhosts/%d/%n
}

# IMAP configuration
protocol imap {
  mail_plugins = $mail_plugins
}

# POP3 configuration
protocol pop3 {
  mail_plugins = $mail_plugins
}

# LMTP configuration
protocol lmtp {
  postmaster_address = postmaster@{{ primary_domain }}
  mail_plugins = $mail_plugins sieve
}

# Postfix SASL auth
service auth {
  unix_listener /var/spool/postfix/private/auth {
    mode = 0660
    user = postfix
    group = postfix
  }
}

# Master user configuration
namespace inbox {
  inbox = yes
}

# Sieve filtering
plugin {
  sieve = file:~/sieve;active=~/.dovecot.sieve
  sieve_default = /var/lib/dovecot/sieve/default.sieve
  sieve_default_name = main
}
