# PostgreSQL configuration for Postfix virtual alias maps
# Generated by Hibana Stack

hosts = localhost
user = hibana
password = {{ lookup('file', '/etc/hibana/passwords/hibana') }}
dbname = hibana

# Query to lookup alias destination
# Input: full email address (e.g., contact@example.com)
# Output: destination email address
query = SELECT destination FROM email_aliases ea JOIN domains d ON ea.domain_id = d.id WHERE CONCAT(ea.source_address, '@', d.name) = '%s'
