# PowerDNS Configuration
# Generated by Hibana Stack

# PostgreSQL Backend
launch=gpgsql
gpgsql-host=127.0.0.1
gpgsql-port=5432
gpgsql-dbname=powerdns
gpgsql-user=pdns
gpgsql-password={{ pdns_db_password }}
gpgsql-dnssec=yes

# API Configuration
api=yes
api-key={{ pdns_api_key }}
webserver=yes
webserver-address=127.0.0.1
webserver-port=8081
webserver-allow-from=127.0.0.1

# Network Settings
local-address=0.0.0.0
local-port=53
master=yes
slave=yes
